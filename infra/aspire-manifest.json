{
  "$schema": "https://json.schemastore.org/aspire-8.0.json",
  "resources": {
    "stemify-postgres": {
      "type": "container.v0",
      "connectionString": "Host={stemify-postgres.bindings.tcp.host};Port={stemify-postgres.bindings.tcp.port};Username=postgres;Password={stemify-postgres-password.value}",
      "image": "docker.io/library/postgres:17.4",
      "env": {
        "POSTGRES_HOST_AUTH_METHOD": "scram-sha-256",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256 --auth-local=scram-sha-256",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "{stemify-postgres-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 5432
        }
      }
    },
    "stemifyidentity": {
      "type": "value.v0",
      "connectionString": "{stemify-postgres.connectionString};Database=stemifyidentity"
    },
    "stemifyclassroom": {
      "type": "value.v0",
      "connectionString": "{stemify-postgres.connectionString};Database=stemifyclassroom"
    },
    "stemifyresource": {
      "type": "value.v0",
      "connectionString": "{stemify-postgres.connectionString};Database=stemifyresource"
    },
    "stemifynotification": {
      "type": "value.v0",
      "connectionString": "{stemify-postgres.connectionString};Database=stemifynotification"
    },
    "pgadmin": {
      "type": "container.v0",
      "image": "dpage/pgadmin4:latest",
      "env": {
        "PGADMIN_DEFAULT_EMAIL": "admin@stemify.com",
        "PGADMIN_DEFAULT_PASSWORD": "{pgadmin-password.value}",
        "PGADMIN_CONFIG_SERVER_MODE": "False",
        "PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED": "False",
        "PGADMIN_LISTEN_PORT": "5050"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http2",
          "targetPort": 5050,
          "external": true
        }
      }
    },
    "identity": {
      "type": "project.v0",
      "path": "../../../Identity/Identity.Web/Identity.Web.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "8084",
        "ConnectionStrings__stemifyidentity": "{stemifyidentity.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http2",
          "external": true,
          "targetPort": 8084
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http2",
          "external": true,
          "targetPort": 8084
        }
      }
    },
    "identity-api": {
      "type": "project.v0",
      "path": "../../../Identity/Identity.API/Identity.API.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "8083",
        "ConnectionStrings__stemifyidentity": "{stemifyidentity.connectionString}",
        "services__identity__http__0": "{identity.bindings.http.url}",
        "services__identity__https__0": "{identity.bindings.https.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http2",
          "external": true,
          "targetPort": 8083
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http2",
          "external": true,
          "targetPort": 8083
        }
      }
    },
    "saga-orchestrator": {
      "type": "project.v0",
      "path": "../../../../Saga.Orchestrator/Saga.Orchestrator/Saga.Orchestrator.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{saga-orchestrator.bindings.http.targetPort}",
        "services__identity__http__0": "{identity.bindings.http.url}",
        "services__identity__https__0": "{identity.bindings.https.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http2"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http2"
        }
      }
    },
    "classroom-api": {
      "type": "project.v0",
      "path": "../../../ClassroomService/Classroom.API/Classroom.API.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "8081",
        "ConnectionStrings__stemifyclassroom": "{stemifyclassroom.connectionString}",
        "RabbitMq__Url": "{rabbitmq-url.value}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http2",
          "external": true,
          "targetPort": 8081
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http2",
          "external": true,
          "targetPort": 8081
        }
      }
    },
    "resource-api": {
      "type": "project.v0",
      "path": "../../../Resource/Resource.API/Resource.API.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "8082",
        "ConnectionStrings__stemifyresource": "{stemifyresource.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http2",
          "external": true,
          "targetPort": 8082
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http2",
          "external": true,
          "targetPort": 8082
        }
      }
    },
    "notification-api": {
      "type": "project.v0",
      "path": "../../../Notification/Notification.API/Notification.API.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{notification-api.bindings.http.targetPort}",
        "ConnectionStrings__stemifynotification": "{stemifynotification.connectionString}",
        "RabbitMq__Url": "{rabbitmq-url.value}",
        "FCM__ProjectId": "{fcm-project-id.value}",
        "FCM__ServiceAccountKeyPath": "{fcm-service-account-key.value}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http2",
          "external": true
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http2",
          "external": true
        }
      }
    },
    "apigateway": {
      "type": "project.v0",
      "path": "../../../../ApiGateways/ApiGateway/ApiGateway.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "8085",
        "services__identity__http__0": "{identity.bindings.http.url}",
        "services__identity__https__0": "{identity.bindings.https.url}",
        "services__identity-api__http__0": "{identity-api.bindings.http.url}",
        "services__identity-api__https__0": "{identity-api.bindings.https.url}",
        "services__classroom-api__http__0": "{classroom-api.bindings.http.url}",
        "services__classroom-api__https__0": "{classroom-api.bindings.https.url}",
        "services__resource-api__http__0": "{resource-api.bindings.http.url}",
        "services__resource-api__https__0": "{resource-api.bindings.https.url}",
        "services__notification-api__http__0": "{notification-api.bindings.http.url}",
        "services__notification-api__https__0": "{notification-api.bindings.https.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http2",
          "external": true,
          "targetPort": 8085
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http2",
          "external": true,
          "targetPort": 8085
        }
      }
    },
    "emulator-api": {
      "type": "project.v0",
      "path": "../../../Services/EmulatorService/Emulator.API/Emulator.API/Emulator.API.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "8080",
        "MongoDb__ConnectionString": "mongodb://localhost:27017",
        "MongoDb__DatabaseName": "stemify-emulator",
        "RedisConfig__Host": "localhost",
        "RedisConfig__Port": "6379",
        "RedisConfig__Password": "",
        "RedisConfig__Ssl": "false"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http2",
          "external": true,
          "targetPort": 8080
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http2",
          "external": true,
          "targetPort": 8080
        }
      }
    },
    "stemify-postgres-password": {
      "type": "parameter.v0",
      "value": "{stemify-postgres-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22
            }
          }
        }
      }
    },
    "pgadmin-password": {
      "type": "parameter.v0",
      "value": "{pgadmin-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22
            }
          }
        }
      }
    },
    "rabbitmq-url": {
      "type": "parameter.v0",
      "value": "{rabbitmq-url.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "default": "amqp://guest:guest@localhost:5672"
        }
      }
    },
    "fcm-project-id": {
      "type": "parameter.v0",
      "value": "{fcm-project-id.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "default": ""
        }
      }
    },
    "fcm-service-account-key": {
      "type": "parameter.v0",
      "value": "{fcm-service-account-key.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": ""
        }
      }
    }
  }
}