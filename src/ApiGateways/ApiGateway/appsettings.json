{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "IdentityServiceUrl": "http://localhost:5000",
  "Issuer": "https://stemify.site",
  "ClientApp": "http://localhost:3000,https://ste-mify-frontend-dev.vercel.app,https://stemify.site",
  "MicrobitApp": "",
  "ForwardedHeaders": {
    "ForwardedHeaders": "XForwardedFor, XForwardedProto, XForwardedHost",
    "KnownNetworks": [],
    "KnownProxies": []
  },
  "ReverseProxy": {
    "Routes": {
      "identity-wellknown-route": {
        "ClusterId": "identity-server-cluster",
        "Match": {
          "Path": "/.well-known/{**catch-all}"
        }
      },
      "identity-connect-route": {
        "ClusterId": "identity-server-cluster",
        "Match": {
          "Path": "/connect/{**catch-all}"
        }
      },
      "identity-account-route": {
        "ClusterId": "identity-server-cluster",
        "Match": {
          "Path": "/Account/{**catch-all}"
        }
      },
      "identity-route": {
