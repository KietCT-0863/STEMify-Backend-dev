          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://product-service:80"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://order-service:80"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://notification-service:80"
          }
        }
      },
      "classroom-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://classroom-service:80"
          }
        }
      },
      "resource-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://resource-service:80"
          }
        }
