@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Kết quả Đặt Lại Mật Khẩu";
    var isSuccess = !string.IsNullOrEmpty(ViewBag.SuccessMessage);
    var isError = !string.IsNullOrEmpty(ViewBag.ErrorMessage);
    var clientAppUrl = Configuration["ClientApp"] ?? "https://localhost:3000";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade-in {
            animation: fadeIn 0.5s ease-out forwards;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
    </style>
</head>
<body class="min-h-screen bg-gray-50 flex flex-col">
    <main class="flex-1 flex items-center justify-center p-4">
        <div class="w-full max-w-xl">
            @if (isSuccess)
            {
                <!-- Success State -->
                <div class="bg-white rounded-2xl shadow-xl border border-gray-200 p-5 md:p-12 text-center animate-fade-in">
                    <!-- Icon -->
                    <div class="mb-6">
                        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-emerald-50">
                            <i class="fas fa-check-circle text-4xl text-emerald-600"></i>
                        </div>
                    </div>

                    <!-- Title -->
                    <h1 class="text-4xl font-bold text-gray-800 mb-4">
                        Mật khẩu đã được đặt lại
                    </h1>

                    <!-- Description -->
                    <p class="text-lg text-gray-600 mb-2">
                        @ViewBag.SuccessMessage
                    </p>

                    @if (!string.IsNullOrEmpty(ViewBag.UserEmail))
                    {
                        <p class="text-base text-gray-500 mb-8">
                            Email: <span class="font-semibold">@ViewBag.UserEmail</span>
                        </p>
                    }

                    <!-- CTA Button -->
                    <a href="@clientAppUrl" class="inline-block bg-sky-500 hover:bg-sky-600 text-white font-medium px-10 py-3 rounded-lg transition-colors duration-200 text-base">
                        Đăng nhập ngay
                    </a>
                </div>
            }
            else
            {
                <!-- Error State -->
                <div class="bg-white rounded-2xl shadow-xl border border-gray-200 p-5 md:p-12 text-center animate-fade-in">
                    <!-- Icon -->
                    <div class="mb-4">
                        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-rose-50">
                            <i class="fas fa-times-circle text-3xl text-rose-500"></i>
                        </div>
                    </div>

                    <!-- Title -->
                    <h1 class="text-2xl font-bold text-gray-800 mb-2">
                        Không thể đặt lại mật khẩu
                    </h1>

                    <!-- Error Message -->
                    <p class="text-base text-gray-600 max-w-xl mx-auto mb-6">
                        @ViewBag.ErrorMessage
                    </p>

                    <!-- Info Box -->
                    <div class="bg-slate-50 rounded-lg p-6 mb-8 text-left max-w-xl mx-auto">
                        <h3 class="font-medium text-gray-900 mb-3">Các nguyên nhân có thể:</h3>
                        <ul class="space-y-2 text-sm text-gray-600">
                            <li class="flex items-start gap-2">
                                <i class="fas fa-circle text-gray-400 text-xs mt-1.5"></i>
                                <span>Liên kết đã hết hạn (sau 1 giờ)</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fas fa-circle text-gray-400 text-xs mt-1.5"></i>
                                <span>Liên kết không chính xác hoặc bị hỏng</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fas fa-circle text-gray-400 text-xs mt-1.5"></i>
                                <span>Tài khoản không tồn tại hoặc đã bị vô hiệu hóa</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Primary Action -->
                    <a asp-action="ForgotPassword" class="inline-block bg-sky-500 hover:bg-sky-600 text-white font-medium px-10 py-3 rounded-lg transition-colors duration-200 text-base mb-4">
                        Yêu cầu liên kết mới
                    </a>

                    <!-- Secondary Link -->
                    <div class="text-base text-gray-600">
                        <span>Đã có tài khoản? </span>
                        <a asp-action="Login" class="text-blue-500 hover:text-blue-700 font-medium transition-colors">Đăng nhập</a>
                    </div>
                </div>
            }
        </div>
    </main>

    <!-- Footer -->
    <footer>
        <div class="container mx-auto px-4">
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center text-sm text-gray-600">
                <span>Cần trợ giúp?</span>
                <a href="mailto:support@stemify.com" class="text-blue-500 hover:text-blue-700 font-medium transition-colors">
                    Liên hệ hỗ trợ
                </a>
            </div>
        </div>
    </footer>
</body>
</html>

