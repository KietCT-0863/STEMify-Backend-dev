# Environment
ENVIRONMENT=Development
LOG_LEVEL=INFO

# Vector Store (Qdrant) - Local
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_URL=http://localhost:6334
QDRANT_COLLECTION=classroom_insights

# Graph Database (Neo4j) - Local
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=test12345

# Embeddings
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# LLM - Remote Provider Selection
LLM_REMOTE_PROVIDER=deepseek  # Options: "deepseek" or "openai"

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# DeepSeek Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# LLM - Local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LLM General Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Agent Remote Model Control
# Set to "true" to use remote models (DeepSeek/OpenAI) instead of local Ollama
STUDENT_AGENTS_USE_REMOTE=false
TEACHER_AGENTS_USE_REMOTE=false
STAFF_AGENTS_USE_REMOTE=false

# Feature Flags
ENABLE_STUDENT_FEATURES=true
ENABLE_SENTIMENT_ANALYSIS=false
ENABLE_STAFF_FEATURES=true
ENABLE_AGENT_POOLING=false
ENABLE_STREAMING_RAG=false

# RAG Settings
VECTOR_SEARCH_TOP_K=20
RERANK_TOP_K=5
GRAPH_TRAVERSAL_DEPTH=3
ENABLE_RELEVANCE_FILTER=true
MIN_RERANK_SCORE=0.3
MIN_COMBINED_SCORE=0.4

# Context Engineering
CONTEXT_MAX_TOKENS=2000
CONTEXT_MAX_ITEMS=20

# Reranker
RERANKER_PROVIDER=local  # Options: "none", "cohere", "local", "llm"
RERANKER_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
