{
  "$schema": "https://json.schemastore.org/aspire-8.0.json",
  "resources": {
    "stemify-postgres": {
      "type": "container.v0",
      "connectionString": "Host={stemify-postgres.bindings.tcp.host};Port={stemify-postgres.bindings.tcp.port};Username=postgres;Password={stemify-postgres-password.value}",
      "image": "docker.io/library/postgres:17.4",
      "env": {
        "POSTGRES_HOST_AUTH_METHOD": "scram-sha-256",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256 --auth-local=scram-sha-256",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "{stemify-postgres-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 5432
        }
      }
    },
    "stemifyidentity": {
      "type": "value.v0",
      "connectionString": "{stemify-postgres.connectionString};Database=stemifyidentity"
    },
    "stemifyclassroom": {
      "type": "value.v0",
      "connectionString": "{stemify-postgres.connectionString};Database=stemifyclassroom"
    },
    "stemifyresource": {
      "type": "value.v0",
      "connectionString": "{stemify-postgres.connectionString};Database=stemifyresource"
    },
    "stemifynotification": {
      "type": "value.v0",
      "connectionString": "{stemify-postgres.connectionString};Database=stemifynotification"
    },
    "stemifyproduct": {
      "type": "value.v0",
      "connectionString": "{stemify-postgres.connectionString};Database=stemifyproduct"
    },
    "stemifyorder": {
      "type": "value.v0",
      "connectionString": "{stemify-postgres.connectionString};Database=stemifyorder"
    },
    "identity": {
      "type": "project.v0",
      "path": "../../../Identity/Identity.Web/Identity.Web.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{identity.bindings.http.targetPort}",
        "ConnectionStrings__stemifyidentity": "{stemifyidentity.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        }
      }
    },
    "identity-api": {
      "type": "project.v0",
      "path": "../../../Identity/Identity.API/Identity.API.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{identity-api.bindings.http.targetPort}",
        "ConnectionStrings__stemifyidentity": "{stemifyidentity.connectionString}",
        "services__identity__http__0": "{identity.bindings.http.url}",
        "services__identity__https__0": "{identity.bindings.https.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        }
      }
    },
    "saga-orchestrator": {
      "type": "project.v0",
      "path": "../../../../Saga.Orchestrator/Saga.Orchestrator/Saga.Orchestrator.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{saga-orchestrator.bindings.http.targetPort}",
        "services__identity__http__0": "{identity.bindings.http.url}",
        "services__identity__https__0": "{identity.bindings.https.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "classroom-api": {
      "type": "project.v0",
      "path": "../../../ClassroomService/Classroom.API/Classroom.API.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{classroom-api.bindings.http.targetPort}",
        "ConnectionStrings__stemifyclassroom": "{stemifyclassroom.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        }
      }
    },
    "resource-api": {
      "type": "project.v0",
      "path": "../../../Resource/Resource.API/Resource.API.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{resource-api.bindings.http.targetPort}",
        "ConnectionStrings__stemifyresource": "{stemifyresource.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        }
      }
    },
    "notification-api": {
      "type": "project.v0",
      "path": "../../../Notification/Notification.API/Notification.API.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{notification-api.bindings.http.targetPort}",
        "ConnectionStrings__stemifynotification": "{stemifynotification.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        }
      }
    },
    "product-api": {
      "type": "project.v0",
      "path": "../../../ProductService/Product.API/Product.API.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{product-api.bindings.http.targetPort}",
        "ConnectionStrings__stemifyproduct": "{stemifyproduct.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        }
      }
    },
    "order-api": {
      "type": "project.v0",
      "path": "../../../OrderService/Order.API/Order.API.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{order-api.bindings.http.targetPort}",
        "ConnectionStrings__stemifyorder": "{stemifyorder.connectionString}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        }
      }
    },
    "apigateway": {
      "type": "project.v0",
      "path": "../../../../ApiGateways/ApiGateway/ApiGateway.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{apigateway.bindings.http.targetPort}",
        "services__identity__http__0": "{identity.bindings.http.url}",
        "services__identity__https__0": "{identity.bindings.https.url}",
        "services__classroom-api__http__0": "{classroom-api.bindings.http.url}",
        "services__classroom-api__https__0": "{classroom-api.bindings.https.url}",
        "services__resource-api__http__0": "{resource-api.bindings.http.url}",
        "services__resource-api__https__0": "{resource-api.bindings.https.url}",
        "services__notification-api__http__0": "{notification-api.bindings.http.url}",
        "services__notification-api__https__0": "{notification-api.bindings.https.url}",
        "services__product-api__http__0": "{product-api.bindings.http.url}",
        "services__product-api__https__0": "{product-api.bindings.https.url}",
        "services__order-api__http__0": "{order-api.bindings.http.url}",
        "services__order-api__https__0": "{order-api.bindings.https.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        }
      }
    },
    "stemify-postgres-password": {
      "type": "parameter.v0",
      "value": "{stemify-postgres-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22
            }
          }
        }
      }
    }
  }
}