{
  "dashboard": {
    "id": null,
    "title": "STEMify Business Metrics",
    "tags": ["stemify", "business"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "User Activity",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(user_registrations_total[5m]))",
            "legendFormat": "Registrations/min"
          },
          {
            "expr": "sum(rate(user_logins_total[5m]))",
            "legendFormat": "Logins/min"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Order Metrics",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(orders_created_total[5m]))",
            "legendFormat": "Orders Created/min"
          },
          {
            "expr": "sum(rate(orders_completed_total[5m]))",
            "legendFormat": "Orders Completed/min"
          },
          {
            "expr": "sum(rate(orders_failed_total[5m]))",
            "legendFormat": "Orders Failed/min"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Payment Processing",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(payments_processed_total[5m]))",
            "legendFormat": "Payments Processed/min"
          },
          {
            "expr": "sum(rate(payments_failed_total[5m]))",
            "legendFormat": "Payments Failed/min"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "System Health",
        "type": "graph",
        "targets": [
          {
            "expr": "active_users",
            "legendFormat": "Active Users"
          },
          {
            "expr": "pending_orders",
            "legendFormat": "Pending Orders"
          },
          {
            "expr": "queue_size",
            "legendFormat": "Queue Size"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "Error Rates",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(database_errors_total[5m]))",
            "legendFormat": "Database Errors/min"
          },
          {
            "expr": "sum(rate(external_api_errors_total[5m]))",
            "legendFormat": "API Errors/min"
          },
          {
            "expr": "sum(rate(validation_errors_total[5m]))",
            "legendFormat": "Validation Errors/min"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "Performance Metrics",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(database_query_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile DB Query Time"
          },
          {
            "expr": "histogram_quantile(0.95, rate(external_api_call_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile API Call Time"
          },
          {
            "expr": "histogram_quantile(0.95, rate(business_operation_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile Business Operation Time"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}
